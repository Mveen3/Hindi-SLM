# ──────────────────────────────────────────────────────────────
# Environment & secrets
# ──────────────────────────────────────────────────────────────
.env
.env.*

# ──────────────────────────────────────────────────────────────
# Corpora — far too large for git.
# Rebuild with scripts/download_data.py + scripts/crawl.py + run_pipeline.sh,
# or pull the processed splits from the Drive link in the README.
# ──────────────────────────────────────────────────────────────
**/data/raw/
**/data/interim/
**/data/processed/
*.jsonl

# Phase 3 reasoning corpora are regenerated by scripts/generate_reasoning_data.py.
# The splits themselves go to Drive (they are large); the phrase bank, the
# qualitative samples, the stats and the append-only authoring log are small
# and make the corpus (and its multi-day authoring history) reproducible.
!**/data/reasoning/phrasebank.json
!**/data/reasoning/samples.txt
!**/data/reasoning/authoring_log.txt
*.parquet

# ──────────────────────────────────────────────────────────────
# Model artifacts — ~280 MB per checkpoint.
# Fetch with: python scripts/download_checkpoint.py --lang <language>
# ──────────────────────────────────────────────────────────────
*.pt
*.pth
**/checkpoints/*
**/logs/*
**/logs_pretraining/*
logs/
*.log
# Phase 3 finetuning artifacts, same policy: weights go to Drive, the loss
# histories behind report/ figures are regenerated by scripts/finetune.py.
**/checkpoints_finetune/*
**/logs_finetune/*
!**/.gitkeep

# Everything under report/ IS graded and must stay tracked.
!report/**

# ──────────────────────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.cache/

# ──────────────────────────────────────────────────────────────
# Notebooks
# ──────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ──────────────────────────────────────────────────────────────
# IDE & OS
# ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ──────────────────────────────────────────────────────────────
# Private working notes (the assignment PDF is kept; scratch is not)
# ──────────────────────────────────────────────────────────────
.hidden/
docs
